#cloud-config
# Template for the agent VM's cloud-init. render-cloud-init.py substitutes the
# @@…@@ placeholders and embeds vm-files/ before the seed ISO is built.
#
# Nothing secret belongs in here — the Claude Code credential is installed
# afterwards, interactively, via `claude setup-token`.

hostname: agent-vm
fqdn: agent-vm.local
preserve_hostname: false

# Two users, deliberately. Putting the admin key on the agent account gave the
# agent NOPASSWD:ALL sudo, so any single approved Bash call was a root shell —
# and root could rewrite the approval gate itself. Maintenance and execution are
# now separate identities.
users:
  # Runs Claude Code. No sudo, no shell: the daemon key is pinned to a forced
  # command that can feed a JSON job to the CLI runner and nothing else. The -R
  # the daemon needs for the approval tunnel still works.
  - name: agent
    # sshd runs a ForceCommand through the account's shell, so this must be a
    # real shell. Confinement comes from the forced command, not from here.
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - 'command="/usr/local/bin/agent-exec",no-agent-forwarding,no-X11-forwarding,no-pty @@AGENT_PUBKEY@@'

  # Maintenance only: `claude setup-token`, pushing updated vm-files, poking
  # around. Never used by the daemon.
  - name: admin
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    lock_passwd: true
    ssh_authorized_keys:
      - '@@ADMIN_PUBKEY@@'
      # Operator keys from bootstrap/operator-keys.pub. On admin only: a shell on
      # the agent account would share the forwarded ssh-agent with anything the
      # human runs, and could read the agent's Claude token.
@@OPERATOR_KEYS@@

package_update: true
packages:
  - git
  # rsync is needed by 40-sync-repos.sh: the host holds the GitHub credential and
  # syncs working copies in, which for 20-30 repos is repeated multi-GB transfers.
  - rsync
  - jq
  - ripgrep
  - curl
  - ca-certificates
  - python3

write_files:
@@WRITE_FILES@@
  # The libvirt NAT network is IPv4-only and the egress policy drops IPv6
  # outright, but Debian's resolver still hands back AAAA records first. Without
  # these two, every apt fetch and curl burns its connect timeout on an
  # unreachable IPv6 address before falling back — which is what made the first
  # build's package install fail outright.
  - path: /etc/apt/apt.conf.d/99-force-ipv4
    permissions: "0644"
    content: |
      Acquire::ForceIPv4 "true";
  - path: /etc/gai.conf
    permissions: "0644"
    content: |
      # Prefer IPv4: this guest has no IPv6 route.
      precedence ::ffff:0:0/96  100
  - path: /etc/ssh/sshd_config.d/90-agent.conf
    permissions: "0644"
    content: |
      PasswordAuthentication no
      PermitRootLogin no
      # The daemon needs -R for the approval tunnel back to the host.
      AllowTcpForwarding remote
      X11Forwarding no

runcmd:
  # Ownership first: write_files runs before users-groups exists, so the staged
  # copies are root-owned and get installed into place here instead.
  - ["mkdir", "-p", "/etc/claude-agent", "/home/agent/memory", "/home/agent/work"]
@@INSTALL_FILES@@
  # Ownership BEFORE the installer: the mkdir above runs as root and `install`
  # only sets ownership on the files it writes, not on parent directories it
  # creates. Leaving this until afterwards makes /home/agent/.claude root-owned
  # and the installer dies with "cannot create directory .claude/downloads".
  - ["chown", "-R", "agent:agent", "/home/agent"]
  # Claude Code's native installer ships a standalone binary — no Node toolchain
  # needed in the guest. It lands in ~/.local/bin.
  # -f makes curl fail loudly on an HTTP error, and `set -o pipefail` means a
  # failed download does not silently feed an empty script into bash.
  - ["su", "-s", "/bin/bash", "agent", "-c", "set -o pipefail; cd /home/agent && HOME=/home/agent curl -fsSL --retry 3 --retry-connrefused https://claude.ai/install.sh | bash"]
  - ["chown", "-R", "agent:agent", "/home/agent"]
  # Re-assert root ownership of the instruction file: the chown above is a
  # blunt -R over /home/agent and would otherwise hand CLAUDE.md back.
  - ["chown", "root:root", "/home/agent/CLAUDE.md"]
  # The agent account has no interactive login, so verify as root with its PATH.
  - ["su", "-s", "/bin/bash", "agent", "-c", "PATH=/home/agent/.local/bin:$PATH claude --version"]
  # review-agent-work.sh fetches the agent's commits over ssh as admin, and
  # git-upload-pack then runs as admin against an agent-owned repo, which
  # safe.directory refuses. admin already has full sudo, so this grants it
  # nothing it lacked.
  - ["su", "-l", "admin", "-c", "git config --global --add safe.directory '*'"]
  # Claude Code's Bash tool strips SSH_AUTH_SOCK, so git is told where the
  # forwarded agent is instead of being expected to inherit it. agent-exec
  # re-points that symlink at the start of every run.
  - ["su", "-s", "/bin/bash", "agent", "-c", "git config --global core.sshCommand 'SSH_AUTH_SOCK=/home/agent/.ssh/agent.sock ssh'"]
  - ["rm", "-rf", "/var/lib/agent-provision"]
  - ["systemctl", "restart", "ssh"]
  # Leave a marker the host can check to confirm provisioning finished.
  - ["touch", "/home/agent/.provisioned"]

final_message: "agent-vm ready after $UPTIME seconds"

# Copy to daemon/.env, fill in, then: chmod 600 daemon/.env
# systemd loads this as an EnvironmentFile. Never commit the real file.

# --- Slack (create the app at api.slack.com/apps, enable Socket Mode) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Your Slack user ID (Profile -> More -> Copy member ID). THE access control:
# only this user can drive the agent or approve tool calls.
AUTHORIZED_USER_ID=U000000000

# Who may TALK to the bot. Leave empty to allow anyone in a channel it has been
# invited to — the invite is the grant. Set a comma-separated list of Slack IDs to
# narrow it. Note that Read/Grep/Glob run with NO approval, so anyone who can talk
# to the bot can read every file in its workspace, private repos included.
# Approving anything not pre-approved remains AUTHORIZED_USER_ID only.
ALLOWED_USERS=

# --- VM bridge ---
VM_HOST=192.168.122.42
VM_USER=agent
VM_SSH_KEY=/home/tibber/.ssh/agent_vm_ed25519
VM_DOMAIN=agent-vm
VM_WORKDIR=/home/agent/work
# Must be the system instance. The unprivileged default is qemu:///session,
# which is a different (empty) hypervisor and would never see the VM.
LIBVIRT_URI=qemu:///system
# Forward the host ssh-agent into the guest so it can clone private repos with
# no credential of its own. Requires slack-claude-ssh-agent.service and a key
# added by bootstrap/load-agent-key.sh. Off unless set.
FORWARD_AGENT=true

# permissive (default): Bash runs without asking unless the command escalates,
# changes the machine, pushes, or reaches outside /home/agent/work. strict:
# every Bash call asks. The policy is enforced by the root-owned hook in the
# guest; this only selects the mode.
AGENT_POLICY=permissive

# --- Approval gate ---
# Must stay below the 900s hook timeout in vm-files/.../settings.json.
APPROVAL_TIMEOUT_S=600
APPROVAL_PORT=9100
TUNNEL_PORT_LOW=9101
TUNNEL_PORT_HIGH=9199

# --- Local state ---
DB_PATH=/home/tibber/.local/share/slack-claude/state.sqlite3
UPDATE_INTERVAL_S=1.2

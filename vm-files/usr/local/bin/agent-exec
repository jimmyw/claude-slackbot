#!/usr/bin/env bash
# Forced command for the daemon's SSH key. The key cannot get a shell — it can
# only feed one JSON job to the Claude Code CLI and read the stream back.
#
# Job on stdin:
#   {
#     "prompt":        "<user text from Slack>",
#     "session_id":    "<uuid>",
#     "resume":        true|false,
#     "run_token":     "<opaque per-run token>",
#     "approval_port": 9101,
#     "cwd":           "/home/agent/work"     (optional)
#   }
#
# stdout is the raw stream-json event stream; the daemon parses it line by line.
set -euo pipefail

log() { printf '%s agent-exec: %s\n' "$(date -Is)" "$*" >&2; }

# The Claude Code native installer puts the binary in ~/.local/bin, which is NOT
# on PATH for a non-login shell — Debian hands an ssh forced command exactly
# /usr/local/bin:/usr/bin:/bin:/usr/games. This script *is* a forced command, so
# without this it fails with "claude: command not found" no matter how healthy
# the install is.
export PATH="${HOME:-/home/agent}/.local/bin:$PATH"

if ! command -v claude >/dev/null 2>&1; then
    log "claude not found on PATH=$PATH"
    exit 69
fi

# `claude setup-token` produces a long-lived token meant to be exported as
# CLAUDE_CODE_OAUTH_TOKEN. A forced command gets a non-interactive, non-login
# shell — it reads neither ~/.bashrc nor ~/.profile — so an exported variable
# never reaches this script. The credential has to come from an explicit file.
#
# The file lives only in the guest, mode 0600, agent-owned. It is deliberately
# NOT passed in the job from the host: the VM is the isolation boundary and owns
# its own credential, and this keeps the token out of the daemon's env and logs.
TOKEN_FILE="${AGENT_TOKEN_FILE:-$HOME/.config/claude-agent/token}"
if [[ -r "$TOKEN_FILE" ]]; then
    CLAUDE_CODE_OAUTH_TOKEN="$(< "$TOKEN_FILE")"
    export CLAUDE_CODE_OAUTH_TOKEN
elif [[ ! -r "$HOME/.claude/.credentials.json" ]]; then
    # Not fatal: let the CLI emit its own "Not logged in" result so the daemon
    # renders something intelligible in Slack rather than a bare exit code.
    log "no token at $TOKEN_FILE and no ~/.claude/.credentials.json"
fi

JOB_FILE="$(mktemp)"
trap 'rm -f "$JOB_FILE"' EXIT
cat > "$JOB_FILE"
[[ -s "$JOB_FILE" ]] || { log "empty job"; exit 64; }

# python3 rather than jq: it is already a hard requirement for the approval hook,
# so this keeps the guest's dependency list one shorter.
get() {
    python3 - "$JOB_FILE" "$1" <<'PY'
import json, sys
with open(sys.argv[1]) as handle:
    job = json.load(handle)
value = job.get(sys.argv[2])
if value is None:
    sys.stdout.write("")
elif isinstance(value, str):
    sys.stdout.write(value)
else:
    sys.stdout.write(json.dumps(value))
PY
}

PROMPT="$(get prompt)"
SESSION_ID="$(get session_id)"
RESUME="$(get resume)"
RUN_TOKEN="$(get run_token)"
APPROVAL_PORT="$(get approval_port)"
CWD="$(get cwd)"
[[ -n "$CWD" ]] || CWD=/home/agent/work

for required in PROMPT SESSION_ID RUN_TOKEN APPROVAL_PORT; do
    [[ -n "${!required}" ]] || { log "missing field: $required"; exit 64; }
done

# The approval hook reads these. They are the only channel by which the hook
# learns where to ask for permission — it never holds a Slack token.
export AGENT_APPROVAL_URL="http://127.0.0.1:${APPROVAL_PORT}/approve"
export AGENT_RUN_TOKEN="$RUN_TOKEN"

cd "$CWD"

# Overridable so the end-to-end test can run this script outside the VM.
SETTINGS="${AGENT_SETTINGS:-/home/agent/.claude/settings.json}"

ARGS=(
    --print "$PROMPT"
    --output-format stream-json
    --verbose
    --settings "$SETTINGS"
)

if [[ "$RESUME" == "true" ]]; then
    ARGS+=(--resume "$SESSION_ID")
else
    ARGS+=(--session-id "$SESSION_ID")
fi

log "starting session=$SESSION_ID resume=$RESUME cwd=$CWD"

# stdin is already consumed by the job read; give the CLI /dev/null so it does
# not sit waiting for piped input.
exec claude "${ARGS[@]}" < /dev/null
